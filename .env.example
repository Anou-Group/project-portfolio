# Copy to .env.local (git-ignored). Never commit real values.

# Runtime (Vercel + local): read-only access, server-side only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>

# Trusted machine only — used by `npm run content:publish`. Never set in Vercel.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Trusted machine only — used by `npm run db:push -- --remote`.
SUPABASE_DB_PASSWORD=<database password>

# Optional: tests and local development read content/ instead of Supabase.
# PORTFOLIO_DATA_SOURCE=content
